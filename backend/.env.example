# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - CHEFSITO AWS BACKEND
# ==============================================================================

# 1. Base de Datos Desplegada (Amazon RDS PostgreSQL o contenedor PostgreSQL)
# Formato: postgresql://USUARIO:CONTRASEÑA@ENDPOINT_RDS:5432/NOMBRE_BD
DATABASE_URL=postgresql://chefsito_admin:ChefsitoSecure2026!@localhost:5432/chefsito_db

# Pool de conexiones para soportar múltiples usuarios simultáneos en RDS (db.t3.micro)
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25

# 2. Seguridad JWT (Cambiar en producción / AWS Systems Manager Parameter Store)
JWT_SECRET_KEY=chefsito-aws-lab-super-secret-jwt-key-243873-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# 3. Clave de Administración para ingesta y carga masiva de recetas
ADMIN_API_KEY=chefsito-admin-243873

# 4. Ingesta Dinámica de Recetas
# Si es true, al arrancar el servidor importa el catálogo base y sincroniza nuevas recetas
AUTO_SEED_ON_STARTUP=true
